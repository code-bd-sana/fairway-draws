datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id        String   @id @default(cuid())
  fullName  String   @map("full_name")
  email     String   @unique
  role      String   @default("CUSTOMER")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("leads")
}
